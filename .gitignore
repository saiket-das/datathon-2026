# Sponsor dataset folder: everything in it stays local, except its README.
/dataset/*
!/dataset/README.md

# Script outputs: only charts and Markdown aggregate tables may be committed.
/analysis/*/out/*
!/analysis/*/out/.gitkeep
!/analysis/*/out/*.png
!/analysis/*/out/*.jpg
!/analysis/*/out/*.svg
!/analysis/*/out/*.pdf
!/analysis/*/out/*.md

# Data-shaped files anywhere else in the repository
/data/
/datasets/
/raw/
/local-data/
*.csv
*.tsv
*.parquet
*.partial
*.arrow
*.feather
*.orc
*.avro
*.jsonl
*.ndjson
# Jupyter notebooks may embed cached sponsor transaction records or outputs.
*.ipynb
*.xlsx
*.xls
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.hdf5
*.duckdb
*.wal
*.sqlite
*.sqlite3
*.db
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz
*.zst

# Local credentials and environment
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# DuckDB spill directory
.duckdb_tmp/
